{
  "name": "@campus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST de Uniminuto Campus App (Fastify + TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx scripts/seed/index.ts",
    "rules:deploy": "node scripts/deploy-firestore-rules.mjs",
    "token:dev": "tsx scripts/dev-token.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@fastify/cors": "^11.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.2.0",
    "firebase-admin": "^13.0.0",
    "jose": "^6.0.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
