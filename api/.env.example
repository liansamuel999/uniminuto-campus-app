# ─────────────────────────────────────────────────────────────────────────────
# Copiar a `.env` (no se versiona) y completar. §7.2: aquí van los secretos de la
# API; la app Flutter nunca contiene secretos.
# ─────────────────────────────────────────────────────────────────────────────

# Servidor
ENTORNO=dev
PORT=3000
LOG_LEVEL=info

# Base de datos (CockroachDB local vía docker-compose, o CockroachDB Cloud en la demo)
DATABASE_URL=postgresql://root@localhost:26257/campus?sslmode=disable

# CORS: lista separada por comas, sin comodines (D-22)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autenticación
# Solo desarrollo: secreto HS256 para tokens de prueba (D-20). Prohibido en prod.
AUTH_DEV_SECRET=cambia-este-secreto-de-desarrollo-1234567890
# Producción: JSON completo de la cuenta de servicio de Firebase en una sola línea.
FIREBASE_SERVICE_ACCOUNT=

# Claves institucionales ES256 (D-25). La privada la genera infra/scripts/generate-keys.mjs.
INSTITUTION_PRIVATE_KEY=
INSTITUTION_KID=

# Datalake S3 (MinIO local; R2 en la demo)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=campus-app
S3_REGION=us-east-1

# Límites de la muestra
UPLOAD_MAX_BYTES=52428800
ENTREGA_GRACIA_HORAS=24
