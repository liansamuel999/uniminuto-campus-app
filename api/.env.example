# ─────────────────────────────────────────────────────────────────────────────
# Configuración de la API. §7.2: aquí viven los secretos; la app Flutter no tiene ninguno.
# Copiar a `.env` (ignorado por git) y completar. Uso:
#   Copy-Item api/.env.example api/.env      (Windows)
#   cp api/.env.example api/.env             (POSIX)
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────
ENTORNO=dev
PORT=3000
LOG_LEVEL=info

# ── Base de datos: CockroachDB Cloud (§7.4) ──────────────────────────────────
# Pegar la cadena de conexión del clúster. Requiere TLS y el certificado raíz:
#   sslmode=verify-full&sslrootcert=C:/ruta/al/root.crt
# En Windows, en la URL usa SIEMPRE barras normales (/) en la ruta del certificado.
# La base debe llamarse `campus` (crear con: cockroach sql --url "<URL>" --execute "CREATE DATABASE IF NOT EXISTS campus").
DATABASE_URL=postgresql://USUARIO:CONTRASENA@TU_CLUSTER.cockroachlabs.cloud:26257/campus?sslmode=verify-full&sslrootcert=C:/ruta/al/root.crt

# Alternativa local con Docker (misma API, sin nube):
# DATABASE_URL=postgresql://root@localhost:26257/campus?sslmode=disable

# ── CORS (lista separada por comas, sin comodines; D-22) ─────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Autenticación (Firebase Authentication) ──────────────────────────────────
# Ruta al JSON de la cuenta de servicio del proyecto Firebase. Relativa a `api/` o absoluta.
# El archivo no se versiona: `api/config/` está en .gitignore.
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Alternativa: el JSON completo en una sola línea (útil en Render, donde no hay archivos).
# FIREBASE_SERVICE_ACCOUNT=

# Solo desarrollo: permite tokens HS256 de prueba (`npm run token:dev`). Prohibido en prod (D-20).
# Si está definido, en dev se aceptan tanto tokens de Firebase como tokens de prueba (D-59).
AUTH_DEV_SECRET=cambia-este-secreto-de-desarrollo-1234567890

# ── Claves institucionales ES256 del carnet (§6.1, D-25) ─────────────────────
# Generar con: node infra/scripts/generate-keys.mjs
# La privada NO se versiona (infra/keys/ está en .gitignore); la pública sí
# (app/assets/keys/institution_jwks.json).
INSTITUTION_KID=inst-2026-11-xxxxxx
INSTITUTION_PRIVATE_KEY_PATH=../infra/keys/institution_private.jwk.json
# Alternativa en Render (sin sistema de archivos): el JWK completo en una línea.
# INSTITUTION_PRIVATE_KEY={"kty":"EC","crv":"P-256",...}

# ── Datalake S3: MinIO local (desarrollo) ────────────────────────────────────
# En la demo se sustituye por Cloudflare R2 cambiando solo estas variables (§6.3).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=campus-app
S3_REGION=us-east-1

# ── Límites de la muestra ────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=52428800
ENTREGA_GRACIA_HORAS=24
